# Supabase Postgres connection string. Use the transaction pooler URL for serverless or shared hosting.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?sslmode=require

# Server session/auth values used by the existing Manus OAuth adapter.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=

# Optional owner restriction. If empty, the first authenticated account can claim owner access once.
OWNER_OPEN_ID=

# Optional integrations.
RESEND_API_KEY=
EMAIL_FROM=Bluebird Airways <onboarding@resend.dev>
AVIATIONSTACK_API_KEY=

PORT=3000
NODE_ENV=production
